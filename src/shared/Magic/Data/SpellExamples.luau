--!strict
--[[
	SpellExamples: concrete, data-driven example spells for every domain, and which runtime
	effect each one produces (the server EffectLibrary route id). They are ordinary recipes from
	the grammar, nothing is special-cased, so they double as:
		- a showcase and teaching list (Composer / Grimoire can surface them),
		- regression tests: Tests/Cast.spec checks each one is valid grammar AND routes to `effect`.

	Powers respect each branch's depth cap (tier 0: 3, tier 1: 5, tier 2: 7, tier 3: 9).
	The five "walkthrough" entries are the worked examples in docs/Runtime.md §6.
]]

export type Example = {
	name: string,
	domain: string,
	effect: string, -- EffectLibrary route id this recipe must reach
	recipe: { branch: string, property: string, verb: string, form: string, power: number, modifiers: { string }?, costProfile: string? },
	description: string,
	walkthrough: string?,
}

