	rumors_enabled = { default = true, description = "Townspeople talk to each other about real places, dens, wild zones, lairs and loose spells nearby, and you overhear them; asking afterwards tells the story, in the Journal and on the map (Services/RumorService, docs/Rumors.md). Off: only the older ask-for-rumours stories." },
	places_enabled = { default = true, description = "Places in the wilds have seeded histories (who made them, what happened, who's there now) and places with no body yet aren't sent to by rumours (Services/PlaceService, docs/WorldPlaces.md). Off: rumours talk about every visible place as before." },
	agendas_enabled = { default = true, description = "The world acts without you: each game day's sieges, raids, alliances and trade are seeded the same on every server; near a player a siege plays out (Wildborn march on the town, guards turn out), and a fallen town is held by Wildborn until someone frees it (Services/AgendaService, docs/LivingHistory.md §8). Off: none of it." },
	history_enabled = { default = true, description = "Things with a past: the item a legend was done with gets an epithet and a line of history, a legend in the wilds names its spot on the map, and each town raises a stone for its biggest legend (Services/HistoryService, docs/LivingHistory.md §6). Off: legends are only told." },
	downed_enabled = { default = true, description = "Losing to anything but another player downs you instead: a passer-by may carry you to a healer, you may come round where you fell, a Wildborn may drag you to its lair, and some coins drop as a purse (Services/DownedService, docs/LivingHistory.md §7). Off: every loss is a death, as before." },
	chronicle_enabled = { default = true, description = "The world remembers its big moments: deeds go into this server's chronicle and the biggest become legends every server shares; people tell them in the evening, when asked for news, and to whoever did them (Services/ChronicleService, docs/LivingHistory.md). Off: only NPCs' own memories." },
