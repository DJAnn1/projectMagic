	spell_collisions_enabled = { default = true, description = "Spells meet in the air: the heavier cuts through, equals shatter or glance, opposed elements react where they meet; beams sweep lighter bolts away (Cast/Delivery, Services/StruggleService). Off: flights pass through each other." },
