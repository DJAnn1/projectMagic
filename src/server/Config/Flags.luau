	sigils_enabled = { default = true, replicate = true, description = "Spells draw crisp sigils: a domain's own pattern at the feet or standing at the hand while casting and charging, snapping out on release, and stamped where spells land (Shared/Magic/Data/Sigils, Client/Fx/Sigils, docs/Smoothness.md stage 2). Off: the old rune circle and discs." },
	local_shots_enabled = { default = true, replicate = true, description = "Your own bolts leave your hand the moment the cast completes on your screen instead of a round trip later; the server's launch takes them over and still decides every hit (Shared/Magic/ShotPlan, Client/Fx/LocalShots, docs/Smoothness.md). Off: bolts appear when the server launches them." },
